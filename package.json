{
  "name": "stm32-stlink-power-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive 3D guide for wiring an STM32 board to an ST-LINK probe for power measurements.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "models": "node scripts/convert-step.mjs ./step ./public/models"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
